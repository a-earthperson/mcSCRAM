# Pins for docker-compose.yml. Public values only; this file is tracked.
FUZZYBITS_SERVER_IMAGE=ghcr.io/fuzzybit-org/fuzzybits-server
FUZZYBITS_SERVER_TAG=v0.18.1
# 127.0.0.1 keeps the unauthenticated server local; use 0.0.0.0 to expose it.
FUZZYBITS_SERVER_BIND=127.0.0.1
FUZZYBITS_SERVER_PORT=8000
FUZZYBITS_SERVER_DEV_PORT=8001
