# fuzzybits pinned toolchain versions (source of truth).
#
# Shell:
#   set -a && . ./toolchain.env && set +a
#
# CMake:
#   include(cmake/ToolchainPins.cmake)  # sets FUZZYBITS_PIN_<KEY>
#
# Docker / CI (--build-arg). Agent H (#26) should take ARG defaults from these
# keys, either by copying the values into Dockerfile ARG lines or by passing:
#   docker build \
#     --build-arg ACPP_REF --build-arg ACPP_REPO \
#     --build-arg CLANG_VERSION \
#     --build-arg CUDA_DEVEL_IMAGE --build-arg CUDA_RUNTIME_IMAGE \
#     --build-arg ACPP_COMPILER_FEATURE_PROFILE \
#     ...
# after `set -a && . ./toolchain.env`. Do not invent a second copy of these
# versions in Dockerfiles or CI YAML.
#
# Skip keys that are not Dockerfile ARGs (BOOST_*, METAL_*, PCFB_*, ACPP_COMMIT,
# ACPP_REF_METAL, ACPP_COMPILER_FEATURE_PROFILE_CUDA_SM70).

# AdaptiveCpp (Dockerfile.cuda12.8 ARG ACPP_REF / ACPP_REPO).
# Tag v25.10.0 peels to commit 9f842c701a599107cc6d117d3539f971036363a1.
ACPP_REPO=https://github.com/AdaptiveCpp/AdaptiveCpp.git
ACPP_REF=v25.10.0
ACPP_COMMIT=9f842c701a599107cc6d117d3539f971036363a1

# LLVM / clang 20: CUDA 12.8 is the last officially supported toolkit for clang 20.
# AdaptiveCpp officially supports LLVM 15–20 (21 is experimental).
CLANG_VERSION=20
LLVM_VERSION=20

# CUDA 12.8.1 images (Dockerfile.cuda12.8 ARG CUDA_DEVEL_IMAGE / CUDA_RUNTIME_IMAGE).
CUDA_VERSION=12.8.1
CUDA_DEVEL_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04

# AdaptiveCpp compiler feature profile.
# full    = SSCP (generic JIT) + clang CUDA SMCP + accelerated CPU
# minimal = SMCP only (no SSCP; ACPP_TARGETS=generic will fail)
# generic / metal variants require full; cuda-sm70 may use minimal to slim the image.
ACPP_COMPILER_FEATURE_PROFILE=full
ACPP_COMPILER_FEATURE_PROFILE_CUDA_SM70=minimal

# Boost: AdaptiveCpp CUDA SMCP (clang -x cuda) needs Boost < 1.87 or >= 1.89
# (1.87/1.88 mark Boost.Math iround as __host__ __device__ with a host-only
# definition). cmake/FindBoost.cmake fetches 1.89.0; keep it >= BOOST_MIN_VERSION.
BOOST_VERSION=1.89.0
BOOST_MIN_VERSION=1.89
BOOST_URL=https://github.com/boostorg/boost/releases/download/boost-1.89.0/boost-1.89.0-cmake.tar.gz
BOOST_SHA256=954a01219bf818c7fb850fa610c2c8c71a4fa28fa32a1900056bcb6ff58cf908

# metal-cpp is not referenced anywhere in this tree. AdaptiveCpp's experimental
# Metal backend (upstream 94e1749, 2026-02, after v25.10.0) takes
# -DMETAL_INCLUDE_DIR and is Apple Silicon / macOS 26 only. Pin the metal-cpp
# release and the AdaptiveCpp ref that contains WITH_METAL_BACKEND in #30;
# do not reuse ACPP_REF=v25.10.0 for metal images.
METAL_CPP_VERSION=TBD
METAL_CPP_ISSUE=https://github.com/fuzzybit-org/fuzzybits/issues/30
ACPP_REF_METAL=TBD

# pcfb v1.1 (private). fuzzybits is public, so Docker injects a named BuildKit
# context rather than FetchContent-with-credentials. CMake FetchContent uses
# this pin when FUZZYBITS_PCFB_SOURCE_DIR is empty (cmake/FuzzybitsPcfb.cmake).
PCFB_GIT_REPO=https://github.com/fuzzybit-org/pcfb.git
PCFB_GIT_TAG=6b1af8bb4bb9af3d217a33317c006f0ff9516cf1
