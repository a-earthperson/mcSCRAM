#include <cassert>
#include <cstdlib>
#include <iostream>

#include <boost/filesystem.hpp>
#include <catch2/catch_session.hpp>

#include "risk_analysis_tests.h"

/// @todo Provide proper parametrized tests.
int main(int argc, char* argv[]) {
  boost::system::error_code ret;
  boost::filesystem::current_path("@CMAKE_SOURCE_DIR@", ret);
  assert(ret == 0);
  auto announce = [] {
    std::cout << "#################### Running with: "
              << scram::core::test::RiskAnalysisTest::parameter_
              << " ####################" << std::endl;
  };

  // Catch2 v3 Session::run is once-per-process.  Re-entering for pi/mocus/zbdd
  // segfaults after the first pass; those algorithms are deferred (#31).
  const char* parameter = "bdd";
  if (const char* env = std::getenv("SCRAM_TEST_ALGORITHM")) {
    parameter = env;
  }
  Catch::Session session;
  scram::core::test::RiskAnalysisTest::parameter_ = parameter;
  announce();
  return session.run(argc, argv);
}
