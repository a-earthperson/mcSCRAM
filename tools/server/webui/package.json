{
  "name": "mcscram-benchmarks",
  "version": "1.0.0",
  "description": "Static GitHub Pages publication for the mcSCRAM benchmark archive.",
  "type": "module",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "backend:build:adaptivecpp:metal": "bash scripts/build-adaptivecpp-metal.sh",
    "backend:build:cli": "bash scripts/build-cli.sh",
    "backend:build:cli:debug": "bash scripts/build-cli-debug.sh",
    "backend:build:native": "bash scripts/build-native.sh",
    "backend:dev": "bash scripts/dev-server.sh",
    "backend:dev:native": "npm run backend:build:native && npm run backend:dev",
    "dev:server": "npm run backend:dev",
    "dev:server:native": "npm run backend:dev:native",
    "data:build": "python3 site/scripts/build_data.py",
    "data:ensure": "test -f docs/data/summary.json || npm run data:build",
    "frontend:build:csr": "vite build --mode production",
    "frontend:build:ssr": "vite build --mode production --ssr src/entry-server.tsx",
    "frontend:build:host": "esbuild site/server.ts --bundle --platform=node --format=esm --outfile=site/.dist/server-host.js --packages=external",
    "frontend:typecheck": "tsc -b",
    "build:csr": "npm run frontend:typecheck && npm run frontend:build:csr && npm run frontend:build:host && npm run data:build",
    "build:ssr": "npm run frontend:typecheck && npm run frontend:build:csr && npm run frontend:build:ssr && npm run frontend:build:host && npm run data:build",
    "build": "npm run build:ssr",
    "dev:csr": "npm run data:ensure && vite --mode development",
    "dev:ssr": "npm run data:ensure && tsx site/dev-ssr.ts",
    "dev:csr:full": "npm run data:ensure && concurrently -k -n csr,api -c blue,green \"vite --mode development\" \"npm:backend:dev\"",
    "dev:ssr:full": "npm run data:ensure && concurrently -k -n ssr,api -c blue,green \"tsx site/dev-ssr.ts\" \"npm:backend:dev\"",
    "start:csr": "FRONTEND_RENDER_MODE=csr node site/.dist/server-host.js",
    "start:ssr": "FRONTEND_RENDER_MODE=ssr node site/.dist/server-host.js",
    "prod:csr": "npm run build:csr && npm run start:csr",
    "prod:ssr": "npm run build:ssr && npm run start:ssr",
    "preview:csr": "npm run prod:csr",
    "preview:ssr": "npm run prod:ssr",
    "preview": "npm run preview:ssr"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "mathbox": "^2.3.1",
    "plotly.js-dist-min": "^3.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.17.0",
    "three": "^0.137.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.137.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
