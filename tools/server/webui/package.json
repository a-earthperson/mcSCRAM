{
  "name": "mcscram-benchmarks",
  "version": "1.0.0",
  "description": "Static GitHub Pages publication for the mcSCRAM benchmark archive.",
  "type": "module",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "predev": "test -f docs/data/summary.json || npm run build:data",
    "dev": "vite",
    "preview": "npm run build && vite preview",
    "build:app": "tsc -b && vite build",
    "build:data": "python3 site/scripts/build_data.py",
    "build": "npm run build:app && npm run build:data"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "plotly.js-dist-min": "^3.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
