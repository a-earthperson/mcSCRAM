{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzybit-org/fuzzybits/blob/develop/benchmarks/schemas/dataset-manifest.v1.json",
  "title": "fuzzybits benchmark dataset manifest",
  "description": "Frozen accuracy/performance dataset v1 (#120). A version never changes once used; edits are v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "description",
    "versioning",
    "submodules",
    "defaults",
    "models"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "dataset": { "type": "string", "const": "v1" },
    "description": { "type": "string", "minLength": 1 },
    "versioning": { "type": "string", "minLength": 1 },
    "submodules": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
    },
    "defaults": { "type": "object" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "source",
        "query",
        "tags",
        "reference",
        "trials",
        "time_budget_s"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "type": "string", "enum": ["aralia", "pwr"] },
        "submodule_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "query": { "type": "string", "minLength": 1 },
        "query_note": { "type": ["string", "null"] },
        "reference": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/reference" }
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["accuracy", "perf", "hard", "pwr"] }
        },
        "perf_reason": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "accuracy": { "$ref": "#/$defs/accuracy" },
        "trials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accuracy": { "type": ["integer", "null"], "minimum": 1 },
            "perf": { "type": ["integer", "null"], "minimum": 1 },
            "cpu_perf": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "expected_hits_accuracy": { "type": ["number", "null"], "minimum": 0 },
        "compile": { "$ref": "#/$defs/compile" },
        "compat": { "$ref": "#/$defs/compat" },
        "time_budget_s": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 },
          "properties": {
            "cpu_accuracy": { "type": "integer", "minimum": 1 },
            "cpu_perf": { "type": "integer", "minimum": 1 },
            "gpu_perf": { "type": "integer", "minimum": 1 },
            "cpu_compile": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check"],
      "properties": {
        "check": {
          "type": "string",
          "enum": ["feasible", "low_power", "infeasible", "n/a"]
        },
        "reason": { "type": ["string", "null"] }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shim", "version"],
      "properties": {
        "shim": { "type": "string", "enum": ["generic_pwr"] },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "compile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected"],
      "properties": {
        "expected": {
          "type": "string",
          "enum": ["ok", "undefined_element", "validity_error"]
        },
        "missing_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": ["string", "null"] }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability", "source", "kind", "uncertainty"],
      "properties": {
        "probability": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["exact", "approximate"] },
        "uncertainty": { "type": "number", "minimum": 0 },
        "citation": { "type": ["string", "null"] }
      }
    }
  }
}
